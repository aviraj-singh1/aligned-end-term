# ALIGNED configuration: copy this file to .env and .env.development as needed.
# Only these three env files belong in the repository root:
#   .env             Vite/browser build settings for local work
#   .env.development Backend development settings and local secrets
#   .env.example     Safe, committed reference
#
# Never commit .env or .env.development. Production values belong in the
# deployment provider's environment settings, not in a repository file.

# -----------------------------------------------------------------------------
# Frontend (public: Vite embeds VITE_* values in the browser bundle)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_ENABLED=true
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# -----------------------------------------------------------------------------
# Backend development
# -----------------------------------------------------------------------------
APP_ENV=development
AUTH_ENABLED=true
AUTH_RECONCILIATION_ENABLED=true
ALLOW_DEMO_MODE=false
AUTH_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
AUTH_FRONTEND_URL=https://aligned-end-term.vercel.app
CORS_ORIGINS=https://aligned-end-term.vercel.app
AUTH_MAIL_DIR=scratch/auth-mail

DATABASE_URL=postgresql+psycopg://aligned_app:CHANGE_ME@localhost:5432/aligned
MIGRATION_DATABASE_URL=postgresql+psycopg://aligned_migrator:CHANGE_ME@localhost:5432/aligned
TEST_DATABASE_URL=postgresql+psycopg://aligned_test:CHANGE_ME@localhost:5432/aligned_test
DATABASE_ROLE=aligned_app
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_POOL_SIZE=0
DB_POOL_TIMEOUT_SECONDS=5

# Supabase server configuration. The URL and publishable key repeat the
# browser's public values because the API independently verifies Supabase
# access tokens. The secret key is backend-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# -----------------------------------------------------------------------------
# Render/runtime settings. Production uses PostgreSQL and ephemeral local files.
# -----------------------------------------------------------------------------
SESSION_STORE_BACKEND=postgres
SESSION_TTL_SECONDS=3600
REQUIRE_S3_OBJECT_STORAGE=false
OBJECT_STORAGE_BACKEND=local
ARTIFACT_DELIVERY_PROVIDER=backend
